# Copy to .env.local. Get the ingestion key in HyperDX: Team Settings > API Keys.

# Server (Node SDK)
HYPERDX_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=hyperdx-nextjs-server
HDX_STARTUP_LOGS=false

# Browser SDK (NEXT_PUBLIC_ values are visible to every visitor)
NEXT_PUBLIC_HYPERDX_API_KEY=
NEXT_PUBLIC_HYPERDX_URL=http://localhost:4318

# Static tags attached to every signal as resource attributes
NEXT_PUBLIC_APP_PROJECT=hyperdx-nextjs-integration
NEXT_PUBLIC_APP_ENV=local
